{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "ogis",
  "colors": {
    "primary": "#000000",
    "light": "#FFFFFF",
    "dark": "#000000"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#000000"
    }
  },
  "favicon": "/favicon.ico",
  "api": {
    "playground": {
      "proxy": false
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "icon": "rocket",
        "pages": [
          "index",
          "getting-started"
        ]
      },
      {
        "group": "Deployment",
        "icon": "server",
        "pages": [
          "self-hosting"
        ]
      },
      {
        "group": "API Reference",
        "icon": "code",
        "openapi": "/openapi.json",
        "pages": [
          "api-reference/overview",
          "api-reference/authentication",
          "api-reference/generate-image",
          "api-reference/compressed-urls",
          "GET /health",
          "GET /c/{blob}",
          "GET /c/{blob}/{sig}"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "href": "https://ogis.dev",
          "icon": "house"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/twangodev/ogis",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo-dark.svg",
    "dark": "/logo-light.svg"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://ogis.dev",
      "github": "https://github.com/twangodev/ogis"
    }
  }
}
