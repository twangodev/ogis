{
  "name": "ogis",
  "version": "0.1.2",
  "type": "module",
  "description": "TypeScript client for OGIS OpenGraph image generation service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "lint": "eslint --fix .",
    "prepublishOnly": "npm run build && cp ../../README.md ."
  },
  "keywords": [
    "opengraph",
    "og-image",
    "image-generation",
    "typescript",
    "ogis"
  ],
  "author": "twangodev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twangodev/ogis.git",
    "directory": "packages/typescript"
  },
  "bugs": {
    "url": "https://github.com/twangodev/ogis/issues"
  },
  "homepage": "https://github.com/twangodev/ogis#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.7.2",
    "vitest": "^4.0.10"
  }
}
