{
  "title": "ogis - Open Graph Images as a Service",
  "uid": "ogis-overview",
  "tags": ["ogis", "otel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "title": "Total Requests",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "histogram_count(sum(increase(http_server_request_duration_seconds{service_name=\"ogis\"}[$__range])))",
        "legendFormat": "total"
      }],
      "options": { "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } }
    },
    {
      "title": "Request Rate",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 5, "h": 4 },
      "targets": [{
        "expr": "histogram_count(sum(rate(http_server_request_duration_seconds{service_name=\"ogis\"}[5m]))) * 60",
        "legendFormat": "req/min"
      }],
      "options": { "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 1 } }
    },
    {
      "title": "P50 Latency",
      "type": "stat",
      "gridPos": { "x": 9, "y": 0, "w": 5, "h": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.50, sum(rate(http_server_request_duration_seconds{service_name=\"ogis\"}[5m])))",
        "legendFormat": "p50"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 1}] } } }
    },
    {
      "title": "P99 Latency",
      "type": "stat",
      "gridPos": { "x": 14, "y": 0, "w": 5, "h": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds{service_name=\"ogis\"}[5m])))",
        "legendFormat": "p99"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 2}] } } }
    },
    {
      "title": "Cache Hit Rate",
      "type": "stat",
      "gridPos": { "x": 19, "y": 0, "w": 5, "h": 4 },
      "targets": [{
        "expr": "(sum(rate(ogis_image_fetch_total{service_name=\"ogis\", cached=\"true\"}[5m])) / sum(rate(ogis_image_fetch_total{service_name=\"ogis\"}[5m])) * 100) or vector(0)",
        "legendFormat": "hit %"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 50}, {"color": "green", "value": 80}] } } }
    },
    {
      "title": "Request Latency Distribution",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_server_request_duration_seconds{service_name=\"ogis\"}[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.90, sum(rate(http_server_request_duration_seconds{service_name=\"ogis\"}[5m])))", "legendFormat": "p90" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds{service_name=\"ogis\"}[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Requests by Template",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum by (template) (histogram_count(rate(ogis_render_duration_seconds{service_name=\"ogis\"}[5m]))) * 60",
        "legendFormat": "{{ template }}"
      }],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "axisSuffix": " /min" } } }
    },
    {
      "title": "Render Duration by Template",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.90, sum by (template) (rate(ogis_render_duration_seconds{service_name=\"ogis\"}[5m])))",
        "legendFormat": "{{ template }} p90"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Image Fetches: Cache Hit vs Miss",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(ogis_image_fetch_total{service_name=\"ogis\", cached=\"true\"}[5m])) * 60", "legendFormat": "Cache Hit" },
        { "expr": "sum(rate(ogis_image_fetch_total{service_name=\"ogis\", cached=\"false\"}[5m])) * 60", "legendFormat": "Cache Miss" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "axisSuffix": " /min" } } }
    },
    {
      "title": "Image Fetches by Domain",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum(rate(ogis_image_fetch_total{service_name=\"ogis\"}[5m])) by (domain) * 60",
        "legendFormat": "{{ domain }}"
      }],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "axisSuffix": " /min" } } }
    },
    {
      "title": "Image Size Distribution",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.90, sum by (type) (rate(ogis_image_size_bytes{service_name=\"ogis\"}[5m])))",
        "legendFormat": "{{ type }} p90"
      }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "Render Queue Wait Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(ogis_render_queue_wait_seconds{service_name=\"ogis\"}[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.99, sum(rate(ogis_render_queue_wait_seconds{service_name=\"ogis\"}[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Response Size",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.90, sum(rate(http_server_response_body_size_bytes{service_name=\"ogis\"}[5m])))",
        "legendFormat": "p90"
      }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "Requests by Status Code",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_count(sum by (http_response_status_code) (rate(http_server_request_duration_seconds{service_name=\"ogis\"}[5m]))) * 60",
        "legendFormat": "{{ http_response_status_code }}"
      }],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "axisSuffix": " /min" } } }
    },
    {
      "title": "Render Duration by Format",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.90, sum by (format) (rate(ogis_render_duration_seconds{service_name=\"ogis\"}[5m])))",
        "legendFormat": "{{ format }} p90"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Output Format Distribution",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 44, "w": 8, "h": 8 },
      "targets": [{
        "expr": "sum by (format) (increase(ogis_output_format_total{service_name=\"ogis\"}[$__range]))",
        "legendFormat": "{{ format }}"
      }],
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Scale Usage Distribution",
      "type": "piechart",
      "gridPos": { "x": 8, "y": 44, "w": 8, "h": 8 },
      "targets": [{
        "expr": "sum by (scale_bucket) (increase(ogis_output_format_total{service_name=\"ogis\"}[$__range]))",
        "legendFormat": "{{ scale_bucket }}"
      }],
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Output Format Rate",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 44, "w": 8, "h": 8 },
      "targets": [{
        "expr": "sum by (format) (rate(ogis_output_format_total{service_name=\"ogis\"}[5m])) * 60",
        "legendFormat": "{{ format }}"
      }],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "axisSuffix": " /min" } } }
    }
  ]
}