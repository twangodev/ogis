{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "rust",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/typescript/package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "charts/ogis": {
      "release-type": "helm",
      "package-name": "ogis",
      "include-component-in-tag": true,
      "component": "chart"
    }
  }
}
