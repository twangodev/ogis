{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "rust",
      "component": "ogis"
    },
    "packages/typescript": {
      "release-type": "node",
      "component": "ogis-typescript"
    },
    "web": {
      "release-type": "node",
      "component": "ogis-web",
      "skip-github-release": true
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "ogis",
      "components": ["ogis", "ogis-typescript"]
    },
    {
      "type": "node-workspace",
      "merge": false
    }
  ]
}
