# Log level: error, warn, info, debug, trace
# Use debug for development, info for production
RUST_LOG=debug

# Server address to bind to (optional, defaults to 0.0.0.0:3000). This can also be set via --addr CLI flag
# OGIS_ADDR=<host>:<port>

# Cache configuration (optional)
# Maximum cache size (default: 2GB)
# Supports human-readable formats: "512MB", "1.5GB", "2GiB", etc.
# Bounded to [256MB, 8GB] for safety
# Docker example with 512MB: docker run -e OGIS_CACHE_MAX_BYTES=512MB
# OGIS_CACHE_MAX_BYTES=2GB
